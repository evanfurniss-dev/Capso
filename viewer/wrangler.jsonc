{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evan-video-pages",
  "account_id": "f7227add8a81a06b92bfd241fbe94435",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "evan-screencap"
    },
    {
      "binding": "ANALYSIS",
      "bucket_name": "evan-video-analysis"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://content.evanfurniss.com",
    "OWNER_NAME": "Evan Furniss"
  },
  "secrets": {
    "required": [
      "ADMIN_PASSWORD"
    ]
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "content.evanfurniss.com/",
      "zone_name": "evanfurniss.com"
    },
    {
      "pattern": "content.evanfurniss.com/v/*",
      "zone_name": "evanfurniss.com"
    },
    {
      "pattern": "content.evanfurniss.com/library*",
      "zone_name": "evanfurniss.com"
    },
    {
      "pattern": "content.evanfurniss.com/login",
      "zone_name": "evanfurniss.com"
    },
    {
      "pattern": "content.evanfurniss.com/logout",
      "zone_name": "evanfurniss.com"
    },
    {
      "pattern": "content.evanfurniss.com/poster.svg",
      "zone_name": "evanfurniss.com"
    },
    {
      "pattern": "content.evanfurniss.com/health",
      "zone_name": "evanfurniss.com"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "media": {
    "binding": "MEDIA"
  },
  "workflows": [
    {
      "name": "evan-video-enrichment",
      "binding": "ENRICHMENT",
      "class_name": "VideoEnrichment"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "evan-video-uploads",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "evan-video-uploads-dlq"
      }
    ]
  }
}
