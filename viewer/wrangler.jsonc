{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evan-video-pages",
  "account_id": "f7227add8a81a06b92bfd241fbe94435",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "evan-screencap"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://content.evanfurniss.com",
    "OWNER_NAME": "Evan Furniss"
  },
  "secrets": {
    "required": [
      "ADMIN_PASSWORD"
    ]
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
